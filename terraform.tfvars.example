aws_region         = "us-east-1"
project_name       = "northwind-campaign"
notification_email = "you@example.com"

repository_url      = "https://github.com/Varun7687/assignment-3.git"
repository_branch   = "assignment-3"
deployment_revision = "initial"

# Optional: a real EXISTING EC2 key-pair name in us-east-1.
# This does not open SSH. Use Session Manager for the assignment tests.
existing_key_pair_name = ""

# Optional: pin a commit SHA or v1.0-campaign after you push it to GitHub.
release_ref = ""

# Optional: pin the resolved AL2023 x86_64 AMI output after initial apply.
ami_id = ""

# Optional explicit AZs; otherwise the first two available AZs are selected.
# availability_zones = ["us-east-1a", "us-east-1b"]
